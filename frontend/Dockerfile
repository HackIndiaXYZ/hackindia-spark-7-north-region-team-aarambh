FROM node:18-alpine

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

# Accept build args and set as ENV for Next.js build
ARG NEXT_PUBLIC_WLD_APP_ID
ENV NEXT_PUBLIC_WLD_APP_ID=$NEXT_PUBLIC_WLD_APP_ID

ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

ARG NEXT_PUBLIC_BLOCKCHAIN_URL
ENV NEXT_PUBLIC_BLOCKCHAIN_URL=$NEXT_PUBLIC_BLOCKCHAIN_URL

ARG NEXT_PUBLIC_CONTRACT_ADDRESS
ENV NEXT_PUBLIC_CONTRACT_ADDRESS=$NEXT_PUBLIC_CONTRACT_ADDRESS

# Build for production
RUN npm run build

EXPOSE 3000

CMD ["npm", "start"]
